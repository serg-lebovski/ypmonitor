@page
@model IndexModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = "Дашборд";
}

<div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <h1 class="page-title" style="margin-bottom:0">Дашборд</h1>
    <span class="muted" id="upd-at" style="font-size:12px"></span>
</div>

<div class="metrics" style="margin-top:14px">
    <div class="metric metric-click" data-filter="all" title="Показать все серверы"><div class="v" id="m-total">@Model.TotalServers</div><div class="l">Серверов всего</div></div>
    <div class="metric metric-click" data-filter="ok" title="Показать только те, что в норме"><div class="v" id="m-ok" style="color:var(--ok)">@Model.OkCount</div><div class="l">В норме</div></div>
    <div class="metric metric-click" data-filter="problem" title="Показать серверы с проблемами архивации"><div class="v" id="m-problem-arch" style="color:var(--err)">@Model.ArchiveProblemCount</div><div class="l">Проблемы архивации</div></div>
    <div class="metric metric-click" data-filter="diskproblem" title="Показать серверы с проблемами дисков"><div class="v" id="m-problem-disk" style="color:var(--err)">@Model.DiskProblemCount</div><div class="l">Проблемы с дисками</div></div>
    <div class="metric metric-click" data-filter="offline" title="Показать только офлайн"><div class="v" id="m-offline" style="color:var(--unknown)">@Model.OfflineCount</div><div class="l">Офлайн</div></div>
</div>

@* --- Фильтры (работают для плиток и для списка по клиентам) --- *@
@if (Model.Clients.Any())
{
    <div class="card-y filter-panel">
        <div class="fp-row">
            <span class="fp-label">Статус:</span>
            <div class="chips">
                <button type="button" class="chip" data-status="all">Все</button>
                <button type="button" class="chip" data-status="ok">В норме</button>
                <button type="button" class="chip" data-status="problem">С проблемами</button>
                <button type="button" class="chip" data-status="offline">Офлайн</button>
            </div>
        </div>
        <div class="fp-row">
            <input type="search" id="dashSearch" class="form-control fp-search" placeholder="Поиск: сервер, машина, IP, клиент…" />
            <select id="dashClient" class="form-select fp-client">
                <option value="">Все клиенты</option>
                @foreach (var c in Model.Clients)
                {
                    <option value="@c.Name.ToLowerInvariant()">@c.Name</option>
                }
            </select>
            <button type="button" class="btn btn-sm btn-primary" id="fpReset">Сбросить</button>
            <span class="muted fp-count" id="fpCount"></span>
        </div>
    </div>

    @* --- Плитки серверов: по одной на сервер, цвет + иконка + подпись статуса --- *@
    <div class="row-title">🖥️ Серверы — последний результат</div>
    <div class="tiles">
        @foreach (var client in Model.Clients)
        {
            foreach (var s in client.Servers)
            {
                var (tStatus, tCls, tIcon, tWord) = UiHelpers.TileStatus(s, Model.OfflineThreshold);
                <div class="tile @tCls" data-tile data-sid="@s.Id" data-status="@tStatus"
                     data-client="@client.Name.ToLowerInvariant()"
                     data-name="@((s.Name + " " + (s.LastMachineName ?? "") + " " + (s.IpAddress ?? "")).ToLowerInvariant())"
                     onclick="location.href='/Servers/Details?id=@s.Id&info=true'"
                     title="@client.Name / @s.Name — @tWord (последний отчёт: @UiHelpers.Ago(s.LastSeenAt))">
                    <div class="tile-status"><span class="tile-ico">@tIcon</span><span class="tile-word">@tWord</span></div>
                    <div class="tile-name">@s.Name</div>
                    <div class="tile-client">@client.Name</div>
                    <div class="tile-sub">@UiHelpers.Ago(s.LastSeenAt)</div>
                </div>
            }
        }
    </div>
}

@* --- Графики: место на дисках + работа архивации. Две равные карточки в ровной сетке. --- *@
<div class="row-title">📊 Ёмкость и архивация</div>
<div class="row g-3 mb-3">
    <div class="col-12 col-lg-6">
        <div class="card h-100" id="diskSection">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>💽 Свободное место на дисках</span>
                @if (Model.DiskProblemServers > 0)
                {
                    <span class="badge-status st-err blink">проблемных серверов: @Model.DiskProblemServers</span>
                }
                else
                {
                    <span class="badge-status st-ok">нет проблем</span>
                }
            </div>
            <div class="card-body">
                <div class="muted mb-2" style="font-size:12px">Кружок — один диск сервера. Красный — ниже порога, оранжевый — близко к порогу. Наведите на кружок для процента.</div>
                @if (!Model.DiskServers.Any())
                {
                    <div class="muted">Пока нет данных о дисках. Они появятся после отчётов агентов.</div>
                }
                else
                {
                    <table class="tbl">
                        <thead><tr><th>Сервер</th><th>Диски</th><th>Худший остаток</th></tr></thead>
                        <tbody>
                        @foreach (var row in Model.DiskServers)
                        {
                            <tr data-drow data-problem="@(row.Problem ? 1 : 0)" style="cursor:pointer"
                                onclick="location.href='/Servers/Details?id=@row.ServerId&info=true'" title="Открыть сервер">
                                <td><strong>@row.Server</strong><div class="muted" style="font-size:12px">@row.Client</div></td>
                                <td class="disk-dots">
                                    @foreach (var d in row.Disks)
                                    {
                                        var dTitle = (string.IsNullOrWhiteSpace(d.Label) ? d.Disk : $"{d.Disk} ({d.Label})")
                                                     + $": {d.FreePercent.ToString("0")}% свободно" + (d.Threshold > 0 ? $" (порог {d.Threshold}%)" : "");
                                        <span class="ddot sev-@d.Sev" title="@dTitle"></span>
                                    }
                                </td>
                                <td class="sev-@(row.Disks.OrderBy(x => x.FreePercent).First().Sev)">@row.WorstFree.ToString("0")%</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="diskShowAll" style="display:none">Показать все диски</button>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">📦 Работа архивации</div>
            <div class="card-body d-flex flex-column">
                <div class="muted mb-3" style="font-size:12px">Итоги полных отчётов по дням за 2 недели.</div>
                <div class="achart flex-grow-1">
                    @foreach (var d in Model.ArchiveDays)
                    {
                        <div class="acol" title="@d.Label — ок: @d.Ok, предупр.: @d.Warning, ошибок: @d.Error">
                            <div class="astack">
                                @if (d.Error > 0)
                                {
                                    <div class="aseg sev-err" style="height:@(d.Error * 150 / Model.ArchiveMaxPerDay)px"></div>
                                }
                                @if (d.Warning > 0)
                                {
                                    <div class="aseg sev-warn" style="height:@(d.Warning * 150 / Model.ArchiveMaxPerDay)px"></div>
                                }
                                @if (d.Ok > 0)
                                {
                                    <div class="aseg sev-ok" style="height:@(d.Ok * 150 / Model.ArchiveMaxPerDay)px"></div>
                                }
                            </div>
                            <div class="alabel">@d.Label</div>
                        </div>
                    }
                </div>
                <div class="legend mt-2">
                    <span><i class="lg sev-ok"></i> норма</span>
                    <span><i class="lg sev-warn"></i> предупреждение</span>
                    <span><i class="lg sev-err"></i> ошибка</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- Список по клиентам --- *@
@if (Model.Clients.Any())
{
    <div class="row-title">🗂️ Серверы по клиентам</div>
}
@if (!Model.Clients.Any())
{
    <div class="card-y">
        Пока нет ни одного клиента. Перейдите в раздел <a href="/Clients">Клиенты</a>, чтобы добавить клиента и подключить агента.
    </div>
}
else
{
    @foreach (var client in Model.Clients)
    {
        var servers = client.Servers;
        var offCnt = servers.Count(x => x.IsOffline(Model.OfflineThreshold));
        var probCnt = servers.Count(x => !x.IsOffline(Model.OfflineThreshold) && x.LastOutcome >= JobOutcome.Warning);
        var shrinkCnt = servers.Count(x => x.BackupShrinkActive);
        var allOk = offCnt == 0 && probCnt == 0 && shrinkCnt == 0 && servers.Any();
        <details class="card-y acc" data-client data-cid="@client.Id" data-problem="@((offCnt + probCnt + shrinkCnt) > 0 ? 1 : 0)" data-name="@client.Name.ToLowerInvariant()">
            <summary>
                <span class="dot cl-dot @(allOk ? "ok" : (offCnt + probCnt) > 0 ? "err blink" : shrinkCnt > 0 ? "warn" : "unknown")"></span>
                🗂️ <strong>@client.Name</strong>
                <span class="muted" style="font-weight:400">— серверов: @servers.Count</span>
                <span class="cl-badges">
                    @if (probCnt > 0) { <span class="badge-status st-err blink">проблемы: @probCnt</span> }
                    @if (offCnt > 0) { <span class="badge-status st-offline">офлайн: @offCnt</span> }
                    @if (shrinkCnt > 0) { <span class="badge-status st-warn">⚠️ объём: @shrinkCnt</span> }
                    @if (allOk) { <span class="badge-status st-ok">всё ок</span> }
                </span>
            </summary>
            <div class="acc-body">
            @if (!servers.Any())
            {
                <div class="muted">Нет серверов</div>
            }
            else
            {
                <table class="tbl">
                    <thead>
                        <tr><th>Сервер</th><th>IP</th><th>Статус</th><th>Посл. бэкап</th><th>Объём</th><th>Посл. отчёт</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var s in servers)
                    {
                        var offline = s.IsOffline(Model.OfflineThreshold);
                        var outcome = offline ? JobOutcome.Unknown : s.LastOutcome;
                        var (lastBackup, sizeBytes) = UiHelpers.BackupSummary(s.LastReportJson);
                        var srvStatus = offline ? "offline"
                            : (s.LastOutcome >= JobOutcome.Warning || s.BackupShrinkActive) ? "problem"
                            : s.LastOutcome == JobOutcome.Ok ? "ok" : "unknown";
                        var rowDotErr = !offline && s.LastOutcome == JobOutcome.Error;
                        <tr style="cursor:pointer" data-server data-sid="@s.Id" data-status="@srvStatus" data-name="@((s.Name + " " + (s.LastMachineName ?? "") + " " + (s.IpAddress ?? "")).ToLowerInvariant())"
                            onclick="location.href='/Servers/Details?id=@s.Id&info=true'">
                            <td><span class="dot row-dot @UiHelpers.DotCss(outcome)@(rowDotErr ? " blink" : "")"></span><strong>@s.Name</strong>
                                <div class="muted" style="font-size:12px">@(s.LastMachineName ?? "")</div></td>
                            <td class="mono">@(s.IpAddress ?? "—")</td>
                            <td class="row-badges">
                                @if (offline)
                                {
                                    <span class="badge-status st-offline">Офлайн</span>
                                }
                                else
                                {
                                    <span class="badge-status @UiHelpers.OutcomeCss(s.LastOutcome)@(s.LastOutcome == JobOutcome.Error ? " blink" : "")">@UiHelpers.OutcomeText(s.LastOutcome)</span>
                                }
                                @if (s.BackupShrinkActive) { <span class="badge-status st-warn">⚠️ объём</span> }
                            </td>
                            <td>@UiHelpers.DateTimeAbs(lastBackup)</td>
                            <td>@UiHelpers.Bytes(sizeBytes)</td>
                            <td class="row-seen">@UiHelpers.DateTimeAbs(s.LastSeenAt)<div class="muted" style="font-size:12px">@UiHelpers.Ago(s.LastSeenAt)</div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>
    }
}

@section Scripts {
    <script>
        // Живое обновление блоков без перезагрузки страницы: опрос /dash/state каждые 10 с
        // и точечный патч цифр, плиток, строк и бейджей. Прокрутка, фильтры и раскрытые
        // клиенты при этом сохраняются (в отличие от прежнего location.reload()).
        (function () {
            var updAt = document.getElementById('upd-at');

            function setDot(el, cls) {
                // Сбрасываем классы состояния, оставляя структурные (dot, cl-dot, row-dot).
                ['ok', 'warn', 'err', 'unknown', 'blink'].forEach(function (c) { el.classList.remove(c); });
                cls.split(' ').forEach(function (c) { if (c) el.classList.add(c); });
            }

            function badge(text, css, blink) {
                return '<span class="badge-status ' + css + (blink ? ' blink' : '') + '">' + text + '</span>';
            }

            function patchTile(t, d) {
                ['t-ok', 't-warn', 't-err', 't-off', 't-unk'].forEach(function (c) { t.classList.remove(c); });
                t.classList.add(d.cls);
                t.setAttribute('data-status', d.status);
                var ico = t.querySelector('.tile-ico'); if (ico) ico.textContent = d.ico;
                var w = t.querySelector('.tile-word'); if (w) w.textContent = d.word;
                var sub = t.querySelector('.tile-sub'); if (sub) sub.textContent = d.ago;
            }

            function patchRow(tr, d) {
                var dot = tr.querySelector('.row-dot');
                if (dot) setDot(dot, d.dot + (d.status === 'problem' && d.badgeCss === 'st-err' ? ' blink' : ''));
                var bc = tr.querySelector('.row-badges');
                if (bc) {
                    var html = badge(d.badgeText, d.badgeCss, d.badgeCss === 'st-err');
                    if (d.shrink) html += ' ' + badge('⚠️ объём', 'st-warn', false);
                    bc.innerHTML = html;
                }
                var seen = tr.querySelector('.row-seen .muted');
                if (seen) seen.textContent = d.ago;
            }

            function patchClient(det, c) {
                var dot = det.querySelector('.cl-dot');
                if (dot) setDot(dot, c.allOk ? 'ok' : (c.prob + c.off) > 0 ? 'err blink' : c.shrink > 0 ? 'warn' : 'unknown');
                var box = det.querySelector('.cl-badges');
                if (!box) return;
                var html = '';
                if (c.prob > 0) html += badge('проблемы: ' + c.prob, 'st-err', true);
                if (c.off > 0) html += badge('офлайн: ' + c.off, 'st-offline', false);
                if (c.shrink > 0) html += badge('⚠️ объём: ' + c.shrink, 'st-warn', false);
                if (c.allOk) html += badge('всё ок', 'st-ok', false);
                box.innerHTML = html;
            }

            function tick() {
                if (document.hidden) return;
                fetch('/dash/state', { credentials: 'same-origin' })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (st) {
                        if (!st) return;
                        var set = function (id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
                        set('m-total', st.counts.total); set('m-ok', st.counts.ok);
                        set('m-offline', st.counts.offline);
                        set('m-problem-arch', st.counts.archiveProblem); set('m-problem-disk', st.counts.diskProblem);

                        document.querySelectorAll('[data-tile][data-sid]').forEach(function (t) {
                            var d = st.servers[t.getAttribute('data-sid')]; if (d) patchTile(t, d);
                        });
                        document.querySelectorAll('tr[data-server][data-sid]').forEach(function (tr) {
                            var d = st.servers[tr.getAttribute('data-sid')];
                            if (d) { tr.setAttribute('data-status', d.status); patchRow(tr, d); }
                        });
                        document.querySelectorAll('details[data-client][data-cid]').forEach(function (det) {
                            var c = st.clients[det.getAttribute('data-cid')]; if (c) patchClient(det, c);
                        });

                        if (updAt) updAt.textContent = 'обновлено ' + st.at;
                        if (window.ypApplyFilters) window.ypApplyFilters();   // держим фильтр в согласии с новыми статусами
                    })
                    .catch(function () { });
            }

            if (updAt) updAt.textContent = 'обновлено ' + new Date().toLocaleTimeString();
            setInterval(tick, 10000);
        })();

        // Фильтры дашборда: статус (кликом по метрике или чипу), поиск, клиент. Состояние сохраняется.
        (function () {
            var sr = document.getElementById('dashSearch');
            var cl = document.getElementById('dashClient');
            var reset = document.getElementById('fpReset');
            var cnt = document.getElementById('fpCount');
            var chips = document.querySelectorAll('.chip[data-status]');
            if (!sr || !cl) return;

            var status = localStorage.getItem('yp_status') || 'all';
            sr.value = sessionStorage.getItem('yp_dashSearch') || '';
            cl.value = sessionStorage.getItem('yp_dashClient') || '';

            function apply() {
                localStorage.setItem('yp_status', status);
                sessionStorage.setItem('yp_dashSearch', sr.value || '');
                sessionStorage.setItem('yp_dashClient', cl.value || '');
                chips.forEach(function (b) { b.classList.toggle('active', b.getAttribute('data-status') === status); });

                var q = (sr.value || '').trim().toLowerCase();
                var cf = cl.value || '';
                var shown = 0;

                // Плитки серверов — под тем же фильтром, что и список.
                document.querySelectorAll('[data-tile]').forEach(function (t) {
                    var st = t.getAttribute('data-status') || '';
                    var nm = t.getAttribute('data-name') || '';
                    var cn = t.getAttribute('data-client') || '';
                    var vis = (status === 'all' || st === status)
                        && (q === '' || nm.indexOf(q) >= 0 || cn.indexOf(q) >= 0)
                        && (cf === '' || cn === cf);
                    t.style.display = vis ? '' : 'none';
                });

                document.querySelectorAll('details[data-client]').forEach(function (d) {
                    var cname = d.getAttribute('data-name') || '';
                    var rows = d.querySelectorAll('tr[data-server]');
                    var any = false;
                    rows.forEach(function (tr) {
                        var st = tr.getAttribute('data-status') || '';
                        var nm = tr.getAttribute('data-name') || '';
                        var okStatus = status === 'all' || st === status;
                        var okQuery = q === '' || nm.indexOf(q) >= 0 || cname.indexOf(q) >= 0;
                        var okClient = cf === '' || cname === cf;
                        var vis = okStatus && okQuery && okClient;
                        tr.style.display = vis ? '' : 'none';
                        if (vis) { any = true; shown++; }
                    });
                    var clientMatch = (cf === '' || cname === cf) && (q === '' || cname.indexOf(q) >= 0);
                    var showClient = rows.length ? any : (status === 'all' && clientMatch);
                    d.style.display = showClient ? '' : 'none';
                    // При активном фильтре разворачиваем клиента, чтобы результат был виден сразу.
                    if (showClient && any && (status !== 'all' || q !== '' || cf !== '')) d.open = true;
                });

                if (cnt) cnt.textContent = 'показано серверов: ' + shown;
            }

            chips.forEach(function (b) {
                b.addEventListener('click', function () { status = b.getAttribute('data-status'); apply(); });
            });
            sr.addEventListener('input', apply);
            cl.addEventListener('change', apply);
            if (reset) reset.addEventListener('click', function () { status = 'all'; sr.value = ''; cl.value = ''; apply(); });

            // Диски — отдельный фильтр: не по статусу сервера, а по строкам таблицы дисков.
            function filterDiskRows(onlyProblem) {
                var sec = document.getElementById('diskSection');
                if (!sec) return;
                sec.querySelectorAll('tr[data-drow]').forEach(function (r) {
                    r.style.display = (!onlyProblem || r.getAttribute('data-problem') === '1') ? '' : 'none';
                });
                var btn = document.getElementById('diskShowAll');
                if (btn) btn.style.display = onlyProblem ? '' : 'none';
            }
            var diskShowAllBtn = document.getElementById('diskShowAll');
            if (diskShowAllBtn) diskShowAllBtn.addEventListener('click', function () { filterDiskRows(false); });

            // Клик по цифрам метрик — переключает фильтр статуса (или, для дисков, прыгает к таблице дисков).
            document.querySelectorAll('.metric-click[data-filter]').forEach(function (m) {
                m.addEventListener('click', function () {
                    var f = m.getAttribute('data-filter');
                    if (f === 'diskproblem') {
                        filterDiskRows(true);
                        var sec = document.getElementById('diskSection');
                        if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        return;
                    }
                    status = f;
                    apply();
                    var fp = document.querySelector('.filter-panel');
                    if (fp) fp.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            });

            window.ypApplyFilters = apply;   // чтобы живое обновление могло переприменить фильтр
            apply();
        })();
    </script>
}
