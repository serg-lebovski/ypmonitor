@page
@model IndexModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = "Дашборд";
}

<div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <h1 class="page-title" style="margin-bottom:0">Дашборд</h1>
    <span class="muted" id="upd-at" style="font-size:12px"></span>
</div>

<div class="metrics" style="margin-top:14px">
    <div class="metric"><div class="v">@Model.TotalServers</div><div class="l">Серверов всего</div></div>
    <div class="metric"><div class="v" style="color:var(--ok)">@Model.OkCount</div><div class="l">В норме</div></div>
    <div class="metric"><div class="v" style="color:var(--err)">@Model.ProblemCount</div><div class="l">С проблемами</div></div>
    <div class="metric"><div class="v" style="color:var(--unknown)">@Model.OfflineCount</div><div class="l">Офлайн</div></div>
</div>

@* --- Графики: место на дисках + работа архивации --- *@
<div class="charts-grid">
    <div class="card-y">
        <h3 style="margin-bottom:4px">💽 Свободное место на дисках</h3>
        <div class="muted" style="font-size:12px;margin-bottom:14px">Худшие по остатку места сверху. Красный — ниже порога, оранжевый — близко к порогу.</div>
        @if (!Model.DiskBars.Any())
        {
            <div class="muted">Пока нет данных о дисках. Они появятся после отчётов агентов.</div>
        }
        else
        {
            foreach (var b in Model.DiskBars)
            {
                <div class="dbar" onclick="location.href='/Servers/Details?id=@b.ServerId&info=true'" title="Открыть сервер">
                    <div class="dbar-top">
                        <span class="dbar-name">@b.Client / <strong>@b.Server</strong> · @b.Disk@(string.IsNullOrWhiteSpace(b.Label) ? "" : $" ({b.Label})")</span>
                        <span class="dbar-val sev-@b.Sev">@b.FreePercent.ToString("0")% свободно</span>
                    </div>
                    <div class="dbar-track">
                        <div class="dbar-fill sev-@b.Sev" style="width:@b.FillPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        @if (b.Threshold > 0)
                        {
                            <div class="dbar-th" style="left:@((100 - b.Threshold).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%" title="порог @b.Threshold% свободного"></div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="card-y">
        <h3 style="margin-bottom:4px">📦 Работа архивации</h3>
        <div class="muted" style="font-size:12px;margin-bottom:14px">Итоги полных отчётов по дням за 2 недели.</div>
        <div class="achart">
            @foreach (var d in Model.ArchiveDays)
            {
                <div class="acol" title="@d.Label — ок: @d.Ok, предупр.: @d.Warning, ошибок: @d.Error">
                    <div class="astack">
                        @if (d.Error > 0)
                        {
                            <div class="aseg sev-err" style="height:@(d.Error * 150 / Model.ArchiveMaxPerDay)px"></div>
                        }
                        @if (d.Warning > 0)
                        {
                            <div class="aseg sev-warn" style="height:@(d.Warning * 150 / Model.ArchiveMaxPerDay)px"></div>
                        }
                        @if (d.Ok > 0)
                        {
                            <div class="aseg sev-ok" style="height:@(d.Ok * 150 / Model.ArchiveMaxPerDay)px"></div>
                        }
                    </div>
                    <div class="alabel">@d.Label</div>
                </div>
            }
        </div>
        <div class="legend">
            <span><i class="lg sev-ok"></i> норма</span>
            <span><i class="lg sev-warn"></i> предупреждение</span>
            <span><i class="lg sev-err"></i> ошибка</span>
        </div>
    </div>
</div>

@* --- Список по клиентам --- *@
@if (Model.Clients.Any())
{
    <div class="dash-toolbar">
        <label class="dt-check"><input type="checkbox" id="onlyProblems" /> Только проблемные</label>
        <input type="search" id="dashSearch" class="form-control dt-search" placeholder="Поиск по клиенту или серверу…" />
    </div>
}
@if (!Model.Clients.Any())
{
    <div class="card-y">
        Пока нет ни одного клиента. Перейдите в раздел <a href="/Clients">Клиенты</a>, чтобы добавить клиента и подключить агента.
    </div>
}
else
{
    @foreach (var client in Model.Clients)
    {
        var servers = client.Servers;
        var offCnt = servers.Count(x => x.IsOffline(Model.OfflineThreshold));
        var probCnt = servers.Count(x => !x.IsOffline(Model.OfflineThreshold) && x.LastOutcome >= JobOutcome.Warning);
        var shrinkCnt = servers.Count(x => x.BackupShrinkActive);
        var allOk = offCnt == 0 && probCnt == 0 && shrinkCnt == 0 && servers.Any();
        <details class="card-y acc" data-client data-problem="@((offCnt + probCnt + shrinkCnt) > 0 ? 1 : 0)" data-name="@client.Name.ToLowerInvariant()">
            <summary>
                <span class="dot @(allOk ? "ok" : (offCnt + probCnt + shrinkCnt) > 0 ? "err" : "unknown")"></span>
                🗂️ <strong>@client.Name</strong>
                <span class="muted" style="font-weight:400">— серверов: @servers.Count</span>
                @if (probCnt > 0) { <span class="badge-status st-err">проблемы: @probCnt</span> }
                @if (offCnt > 0) { <span class="badge-status st-offline">офлайн: @offCnt</span> }
                @if (shrinkCnt > 0) { <span class="badge-status st-warn">⚠️ объём: @shrinkCnt</span> }
                @if (allOk) { <span class="badge-status st-ok">всё ок</span> }
            </summary>
            <div class="acc-body">
            @if (!servers.Any())
            {
                <div class="muted">Нет серверов</div>
            }
            else
            {
                <table class="tbl">
                    <thead>
                        <tr><th>Сервер</th><th>IP</th><th>Статус</th><th>Посл. бэкап</th><th>Объём</th><th>Посл. отчёт</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var s in servers)
                    {
                        var offline = s.IsOffline(Model.OfflineThreshold);
                        var outcome = offline ? JobOutcome.Unknown : s.LastOutcome;
                        var (lastBackup, sizeBytes) = UiHelpers.BackupSummary(s.LastReportJson);
                        var srvProblem = offline || s.LastOutcome >= JobOutcome.Warning || s.BackupShrinkActive;
                        <tr style="cursor:pointer" data-server data-problem="@(srvProblem ? 1 : 0)" data-name="@((s.Name + " " + (s.LastMachineName ?? "")).ToLowerInvariant())"
                            onclick="location.href='/Servers/Details?id=@s.Id&info=true'">
                            <td><span class="dot @UiHelpers.DotCss(outcome)"></span><strong>@s.Name</strong>
                                <div class="muted" style="font-size:12px">@(s.LastMachineName ?? "")</div></td>
                            <td class="mono">@(s.IpAddress ?? "—")</td>
                            <td>
                                @if (offline)
                                {
                                    <span class="badge-status st-offline">Офлайн</span>
                                }
                                else
                                {
                                    <span class="badge-status @UiHelpers.OutcomeCss(s.LastOutcome)">@UiHelpers.OutcomeText(s.LastOutcome)</span>
                                }
                                @if (s.BackupShrinkActive) { <span class="badge-status st-warn">⚠️ объём</span> }
                            </td>
                            <td>@UiHelpers.DateTimeAbs(lastBackup)</td>
                            <td>@UiHelpers.Bytes(sizeBytes)</td>
                            <td>@UiHelpers.DateTimeAbs(s.LastSeenAt)<div class="muted" style="font-size:12px">@UiHelpers.Ago(s.LastSeenAt)</div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>
    }
}

@section Scripts {
    <script>
        // Время последнего обновления страницы.
        document.getElementById('upd-at').textContent = 'обновлено ' + new Date().toLocaleTimeString();

        // Мягкое автообновление: раз в 60 с, только когда вкладка активна и нет активного поиска.
        setInterval(function () {
            var sr = document.getElementById('dashSearch');
            var typing = sr && document.activeElement === sr;
            if (!document.hidden && !typing) location.reload();
        }, 60000);

        // Фильтр «только проблемные» + поиск по клиенту/серверу. Состояние — в localStorage.
        (function () {
            var cb = document.getElementById('onlyProblems');
            var sr = document.getElementById('dashSearch');
            if (!cb || !sr) return;
            cb.checked = localStorage.getItem('yp_onlyProblems') === '1';
            sr.value = sessionStorage.getItem('yp_dashSearch') || '';
            function apply() {
                var only = cb.checked;
                var q = (sr.value || '').trim().toLowerCase();
                localStorage.setItem('yp_onlyProblems', only ? '1' : '0');
                sessionStorage.setItem('yp_dashSearch', sr.value || '');
                document.querySelectorAll('details[data-client]').forEach(function (d) {
                    var clientName = d.getAttribute('data-name') || '';
                    var rows = d.querySelectorAll('tr[data-server]');
                    var anyVisible = false;
                    rows.forEach(function (tr) {
                        var prob = tr.getAttribute('data-problem') === '1';
                        var name = tr.getAttribute('data-name') || '';
                        var show = (!only || prob) && (q === '' || name.indexOf(q) >= 0 || clientName.indexOf(q) >= 0);
                        tr.style.display = show ? '' : 'none';
                        if (show) anyVisible = true;
                    });
                    var clientMatch = q === '' || clientName.indexOf(q) >= 0;
                    var showClient = rows.length ? anyVisible : (!only && clientMatch);
                    d.style.display = showClient ? '' : 'none';
                    if (showClient && (only || q !== '') && anyVisible) d.open = true;
                });
            }
            cb.addEventListener('change', apply);
            sr.addEventListener('input', apply);
            apply();
        })();
    </script>
}
