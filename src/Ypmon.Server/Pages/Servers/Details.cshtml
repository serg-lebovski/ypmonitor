@page
@model Ypmon.Server.Pages.Servers.DetailsModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = Model.Server?.Name ?? "Сервер";
    var canEdit = User.CanEdit();
    var s = Model.Server!;
    var offline = s.IsOffline(Model.OfflineThreshold);
    var localUrl = $"{Request.Scheme}://{Request.Host.Host}:{Ypmon.Server.Services.ServerPorts.ReportsPort}";
    var externalUrl = string.IsNullOrWhiteSpace(Model.ExternalAddress) ? null : $"http://{Model.ExternalAddress}:{Model.ExternalPort}";
    var (lastBackup, sizeBytes) = UiHelpers.BackupSummary(s.LastReportJson);
}

<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
    <h1 class="page-title" style="margin-bottom:0">🖥️ @s.Name</h1>
    <div style="display:flex;gap:8px;align-items:center">
        @if (Model.Info)
        {
            @* Переход с дашборда: только информация + кнопка перехода к настройке мониторинга *@
            @if (canEdit)
            {
                <a class="btn btn-sm btn-primary" href="/Servers/Details?id=@s.Id">⚙️ Настроить мониторинг сервера</a>
            }
            <a class="btn btn-sm btn-primary" href="/">← дашборд</a>
        }
        else
        {
            @* Проверка со стороны сервера: живой пинг внешнего IP + пересчёт тревог по дискам
               по уже полученным данным — сразу, без ожидания фонового цикла и без участия агента. *@
            <form method="post" asp-page-handler="CheckNow" asp-route-id="@s.Id">
                <button class="btn btn-sm btn-primary" type="submit" title="Пинг внешнего IP и пересчёт тревог по дискам прямо сейчас">🔍 Проверить сейчас</button>
            </form>
            @* Команды агенту: сервер передаёт только номер команды из закрытого списка. *@
            <form method="post" asp-page-handler="RequestReport" asp-route-id="@s.Id">
                <button class="btn btn-sm btn-primary" type="submit" title="Агент пришлёт свежий отчёт при следующей связи">🔄 Запросить отчёт</button>
            </form>
            @if (canEdit)
            {
                <form method="post" asp-page-handler="RequestUpdate" asp-route-id="@s.Id"
                      onsubmit="return confirm('Отправить агенту команду на принудительное обновление? Агент скачает установщик с этого сервера и перезапустит службу.')">
                    <button class="btn btn-sm btn-primary" type="submit" title="Агент проверит и установит обновление при следующей связи">⬆️ Обновить агента</button>
                </form>
                <form method="post" asp-page-handler="RequestReboot" asp-route-id="@s.Id"
                      onsubmit="return confirm('ПЕРЕЗАГРУЗИТЬ СЕРВЕР «@s.Name»?\n\nМашина уйдёт в перезагрузку через минуту после того, как агент получит команду. Все работающие на ней задачи будут прерваны.\n\nПродолжить?')">
                    <button class="btn btn-sm btn-danger" type="submit" title="Агент перезагрузит машину при следующей связи">⚡ Перезагрузить сервер</button>
                </form>
            }
            <a class="btn btn-sm btn-primary" href="/Servers">☰ все серверы</a>
            <a class="btn btn-sm btn-primary" href="/Clients/Details?id=@s.ClientId">← к клиенту @s.Client?.Name</a>
        }
    </div>
</div>
<div style="height:14px"></div>
@if (s.ReportRequested)
{
    <div class="alert-y alert-ok">⏳ Запрошен свежий отчёт — ожидаем ответ агента.</div>
}
@if (s.UpdateRequested)
{
    <div class="alert-y alert-ok">⏳ Отправлена команда на обновление агента — выполнится при следующей связи.</div>
}

@if (Model.Message is not null)
{
    <div class="alert-y alert-ok">@Model.Message</div>
}

@{ var muteReason = AlertSuppression.MuteReason(s, DateTimeOffset.UtcNow); }
@if (muteReason is not null)
{
    <div class="alert-y" style="background:rgba(138,152,176,.12);border:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <span>🔇 Тревоги по серверу сейчас не отправляются — @muteReason@(string.IsNullOrWhiteSpace(s.AlertSnoozeReason) ? "" : $" ({s.AlertSnoozeReason})"). Проблемы всё равно видны здесь и в отчёте.</span>
        @if (canEdit && s.AlertSnoozeUntil is not null)
        {
            <form method="post" asp-page-handler="Snooze" asp-route-id="@s.Id">
                <input type="hidden" name="hours" value="0" />
                <button class="btn btn-sm btn-primary" type="submit">Снять заглушку</button>
            </form>
        }
    </div>
}

@if (s.BackupShrinkActive)
{
    var dropPct = s.BackupShrinkFromBytes > 0 ? (1 - (double)s.BackupShrinkToBytes / s.BackupShrinkFromBytes) * 100 : 0;
    <div class="alert-y alert-err" style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <span>⚠️ Новый файл бэкапа резко меньше предыдущего@(string.IsNullOrWhiteSpace(s.BackupShrinkFolder) ? "" : $" (папка «{s.BackupShrinkFolder}»)"): было @UiHelpers.Bytes(s.BackupShrinkFromBytes), стало @UiHelpers.Bytes(s.BackupShrinkToBytes) (−@dropPct.ToString("0")%, @UiHelpers.Ago(s.BackupShrinkAt)). Проверьте, всё ли верно.</span>
        @if (canEdit)
        {
            <form method="post" asp-page-handler="AckShrink" asp-route-id="@s.Id">
                <button class="btn btn-sm btn-primary" type="submit">✔️ Так и должно быть</button>
            </form>
        }
    </div>
}

<div>
        <div class="card-y">
            <div class="mb-2">
                @if (offline)
                {
                    <span class="badge-status st-offline">Офлайн</span>
                }
                else
                {
                    var problemFolders = Model.Report?.Folders
                        .Where(f => f.Outcome != JobOutcome.Ok)
                        .Select(f => $"{f.Name}: {UiHelpers.FolderReason(f, UiHelpers.FolderStale(f.Name, Model.FolderStaleDays, s.BackupStaleDays, Model.DefaultBackupStaleDays))}")
                        .ToList() ?? new();
                    var summary = problemFolders.Count > 0 ? string.Join("\n", problemFolders) : UiHelpers.OutcomeText(s.LastOutcome);
                    <span class="badge-status @UiHelpers.OutcomeCss(s.LastOutcome)" title="@summary">@UiHelpers.OutcomeText(s.LastOutcome)</span>
                }
            </div>
            <div class="kv"><span class="k">Клиент</span><span class="v">@s.Client?.Name</span></div>
            <div class="kv"><span class="k">Физ. адрес</span><span class="v">@(s.PhysicalAddress ?? "—")</span></div>
            <div class="kv"><span class="k">Локальный IP</span><span class="v">@(s.IpAddress ?? "—")</span></div>
            <div class="kv"><span class="k">Внешний IP (роутер)</span><span class="v">@(s.ExternalIpAddress ?? "—")</span></div>
            <div class="kv"><span class="k">Машина агента</span><span class="v">@(s.LastMachineName ?? "—")</span></div>
            <div class="kv"><span class="k">Версия агента</span><span class="v">@(s.LastAgentVersion ?? "—")</span></div>
            @{ var pending = Ypmon.Server.Services.RemoteCommandService.PendingOf(s); }
            @if (pending != Ypmon.Shared.AgentCommand.None)
            {
                <div class="kv"><span class="k">Ожидает команда</span><span class="v">
                    <strong>@Ypmon.Server.Services.RemoteCommandService.Title(pending)</strong>
                    <span class="muted">— выдал @s.PendingCommandBy, @UiHelpers.Ago(s.PendingCommandAt); агент заберёт при следующей связи</span>
                    @if (canEdit)
                    {
                        <form method="post" asp-page-handler="CancelCommand" asp-route-id="@s.Id" style="display:inline;margin-left:8px">
                            <button class="btn btn-sm" type="submit">отменить</button>
                        </form>
                    }
                </span></div>
            }
            else if (s.LastExecutedCommandAt is not null)
            {
                <div class="kv"><span class="k">Последняя команда</span><span class="v muted">выполнена @UiHelpers.Ago(s.LastExecutedCommandAt)</span></div>
            }
            <div class="kv"><span class="k">Температура ЦП</span><span class="v">
                @if (s.LastCpuTemperatureC is { } cpuT)
                {
                    <span>@cpuT.ToString("0.#") °C</span>
                    @if (s.AlertCpuOverheatActive)
                    {
                        <span class="badge b-err" style="margin-left:6px">🔥 перегрев</span>
                    }
                }
                else
                {
                    <span class="muted">нет данных <span style="font-size:11px">(датчик недоступен или агент до 2.6)</span></span>
                }
            </span></div>
            <div class="kv"><span class="k">Последний отчёт</span><span class="v">@UiHelpers.DateTimeAbs(s.LastSeenAt) <span class="muted">(@UiHelpers.Ago(s.LastSeenAt))</span></span></div>
            <div class="kv"><span class="k">Интервалы агента</span><span class="v">связь: @UiHelpers.Duration(s.LastHeartbeatIntervalSeconds) · отчёт: @UiHelpers.Duration(s.LastReportIntervalSeconds)</span></div>
            <div class="kv"><span class="k">Последний бэкап</span><span class="v">@UiHelpers.DateTimeAbs(lastBackup)</span></div>
            <div class="kv"><span class="k">Объём копий</span><span class="v">@UiHelpers.Bytes(sizeBytes) <span class="muted">(файлов: @s.LastBackupCount)</span></span></div>
            <div class="kv"><span class="k">Порог устаревания</span><span class="v">@(s.BackupStaleDays > 0 ? s.BackupStaleDays + " дн." : $"по умолчанию ({Model.DefaultBackupStaleDays} дн.)")</span></div>
        </div>

        <details class="card-y acc">
            <summary>📁 Папки бэкапов (архивация)</summary>
            <div class="acc-body">
            @if (Model.Report is null || !Model.Report.Folders.Any())
            {
                <div class="muted">Агент ещё не прислал данные по папкам.</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Папка</th><th>Статус</th><th>Файлов</th><th>Общий объём</th><th>Посл. архив</th><th>Посл. файл</th></tr></thead>
                    <tbody>
                    @foreach (var f in Model.Report.Folders)
                    {
                        var fStale = UiHelpers.FolderStale(f.Name, Model.FolderStaleDays, Model.Server!.BackupStaleDays, Model.DefaultBackupStaleDays);
                        var reason = UiHelpers.FolderReason(f, fStale);
                        <tr>
                            <td><span class="dot @UiHelpers.DotCss(f.Outcome)"></span>@f.Name
                                <div class="muted" style="font-size:12px">@f.Path</div>
                                @if (f.Outcome != JobOutcome.Ok && !string.IsNullOrWhiteSpace(reason))
                                {
                                    <div style="font-size:12px;color:var(--err,#be3030)">⚠ @reason</div>
                                }
                            </td>
                            <td><span class="badge-status @UiHelpers.OutcomeCss(f.Outcome)"
                                      title="@(string.IsNullOrWhiteSpace(reason) ? UiHelpers.OutcomeText(f.Outcome) : reason)">@UiHelpers.OutcomeText(f.Outcome)</span></td>
                            <td>@f.FileCount</td>
                            <td>@UiHelpers.Bytes(f.TotalSizeBytes)</td>
                            <td>@(f.LastFileSizeBytes > 0 ? UiHelpers.Bytes(f.LastFileSizeBytes) : "—")<div class="muted" style="font-size:11px">@f.LastFileName</div></td>
                            <td>@UiHelpers.DateTimeAbs(f.LastBackupAt)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>

        <details class="card-y acc">
            <summary>📈 Тренд объёма бэкапа</summary>
            <div class="acc-body">
            @if (Model.BackupTrend.Count < 2)
            {
                <div class="muted">Недостаточно данных для тренда — нужно ≥2 полных отчётов (heartbeat не в счёт).</div>
            }
            else
            {
                <div class="achart">
                    @foreach (var p in Model.BackupTrend)
                    {
                        var h = p.Size > 0 ? Math.Max(2, (int)(p.Size * 150L / Model.BackupTrendMax)) : 0;
                        <div class="acol" title="@p.Label — @UiHelpers.Bytes(p.Size)">
                            <div class="astack">
                                <div class="aseg" style="height:@(h)px;background:var(--accent);border-radius:4px 4px 0 0"></div>
                            </div>
                            <div class="alabel">@(p.Label.Length >= 5 ? p.Label[..5] : p.Label)</div>
                        </div>
                    }
                </div>
                <div class="muted" style="font-size:12px;margin-top:16px">
                    По последним @Model.BackupTrend.Count полным отчётам. Максимум: @UiHelpers.Bytes(Model.BackupTrendMax) ·
                    последний: @UiHelpers.Bytes(Model.BackupTrend[^1].Size).
                </div>
            }
            </div>
        </details>

        <details class="card-y acc">
            <summary>💽 Диски</summary>
            <div class="acc-body">
            @if (!Model.Disks.Any())
            {
                <div class="muted">Агент ещё не прислал данные о дисках (нужен агент версии 2.2+).</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Диск</th><th>Общий объём</th><th>Занято</th><th>Порог</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model.Disks)
                    {
                        var usedPct = 100 - d.FreePercent;
                        var th = Model.DiskThresholds.TryGetValue(d.Name, out var tv) ? tv : Model.DiskDefaultPercent;
                        var hasTh = th > 0;
                        var alarm = hasTh && d.FreePercent < th;
                        <tr>
                            <td><strong>@d.Name</strong>@(d.Label is null ? "" : $" ({d.Label})")</td>
                            <td>@UiHelpers.Bytes(d.TotalBytes)</td>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <div class="disk-donut @(alarm ? "d-err" : usedPct > 85 ? "d-warn" : "d-ok")"
                                         style="--p:@usedPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                         title="Свободно @UiHelpers.Bytes(d.FreeBytes) (@d.FreePercent.ToString("0")%)">
                                        <span>@usedPct.ToString("0")%</span>
                                    </div>
                                    <span>@UiHelpers.Bytes(d.TotalBytes - d.FreeBytes)</span>
                                </div>
                            </td>
                            <td>
                                @if (alarm)
                                {
                                    <span class="badge-status st-err">меньше @th% свободно</span>
                                }
                                else if (hasTh)
                                {
                                    <span class="muted">мин. @th% свободно</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>

        <details class="card-y acc">
            <summary>🩺 Здоровье накопителей (SMART)</summary>
            <div class="acc-body">
            @if (!Model.PhysicalDisks.Any())
            {
                <div class="muted">Нет данных SMART (нужен агент версии 2.5+; на виртуальных дисках WMI может не отдавать SMART).</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Накопитель</th><th>Здоровье</th><th>Температура</th><th>Объём</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.PhysicalDisks)
                    {
                        var css = p.Health switch { "Healthy" => "st-ok", "Warning" => "st-warn", "Unhealthy" => "st-err", _ => "st-unknown" };
                        var htext = p.Health switch { "Healthy" => "Здоров", "Warning" => "Предупреждение", "Unhealthy" => "Неисправен", _ => "Нет данных" };
                        <tr>
                            <td><strong>@p.Name</strong>@(string.IsNullOrWhiteSpace(p.Serial) ? "" : "")
                                @if (!string.IsNullOrWhiteSpace(p.Serial)) { <div class="muted" style="font-size:11px">S/N @p.Serial</div> }</td>
                            <td><span class="badge-status @css">@htext</span></td>
                            <td>@(p.TemperatureC is int t ? $"{t} °C" : "—")</td>
                            <td>@(p.SizeBytes > 0 ? UiHelpers.Bytes(p.SizeBytes) : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>

        @{ var latest = Model.History.FirstOrDefault(); var prev = Model.History.Skip(1).ToList(); }
        <details class="card-y acc">
            <summary>
                🕓 Последний отчёт:
                @if (latest is not null)
                {
                    <span class="mono" style="font-weight:400">@UiHelpers.DateTimeAbs(latest.ReceivedAt)</span>
                    <span class="badge-status @UiHelpers.OutcomeCss(latest.Outcome)">@UiHelpers.OutcomeText(latest.Outcome)</span>
                }
                else
                {
                    <span class="muted" style="font-weight:400">пока нет отчётов</span>
                }
            </summary>
            <div class="acc-body">
            @if (prev.Count == 0)
            {
                <div class="muted">Предыдущих отчётов пока нет.</div>
            }
            else
            {
                <div class="muted mb-2" style="font-size:13px">Предыдущие отчёты:</div>
                <table class="tbl">
                    <thead><tr><th>Время</th><th>Статус</th><th>Файлов</th></tr></thead>
                    <tbody>
                    @foreach (var r in prev)
                    {
                        <tr>
                            <td>@UiHelpers.DateTimeAbs(r.ReceivedAt)</td>
                            <td><span class="badge-status @UiHelpers.OutcomeCss(r.Outcome)">@UiHelpers.OutcomeText(r.Outcome)</span></td>
                            <td>@r.BackupCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>

        <details class="card-y acc">
            <summary>⚠️ Ошибки журнала Windows</summary>
            <div class="acc-body">
            @if (!Model.Events.Any())
            {
                <div class="muted">Ошибок из журнала Windows пока нет.</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Время</th><th>Уровень</th><th>Журнал / источник</th><th>ID</th><th>Сообщение</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.Events)
                    {
                        var lvlCss = e.Level == "Warning" ? "st-warn" : "st-err";
                        <tr>
                            <td style="white-space:nowrap">@UiHelpers.DateTimeAbs(e.TimeCreated)</td>
                            <td><span class="badge-status @lvlCss">@e.Level</span></td>
                            <td>@e.LogName<div class="muted" style="font-size:12px">@e.Source</div></td>
                            <td>@e.EventId</td>
                            <td style="max-width:420px"><div style="white-space:pre-wrap;font-size:12px;max-height:120px;overflow:auto">@e.Message</div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            </div>
        </details>
    </div>

    @if (!Model.Info)
    {
    <div class="settings-grid">
        <details class="card-y acc" open>
            <summary>🔌 Данные подключения агента</summary>
            <div class="acc-body">
            <div class="conn-box">
                <div class="muted" style="font-size:12px;margin-bottom:4px">Адрес сервера — агент в одной сети с сервером (локально)</div>
                <div class="copy-row">
                    <input class="form-control mono" readonly value="@localUrl" id="url" />
                    <button type="button" class="btn btn-sm btn-primary" onclick="ypCopy('url', this)">Копировать</button>
                </div>
                <div class="muted" style="font-size:12px;margin:8px 0 4px">Адрес сервера — удалённый агент (внешний адрес)</div>
                @if (externalUrl is not null)
                {
                    <div class="copy-row">
                        <input class="form-control mono" readonly value="@externalUrl" id="urlExt" />
                        <button type="button" class="btn btn-sm btn-primary" onclick="ypCopy('urlExt', this)">Копировать</button>
                    </div>
                }
                else
                {
                    <div class="muted" style="font-size:12px">Укажите внешний адрес в <a href="/Settings">Настройки → Параметры сервера</a>.</div>
                }
                <div class="muted" style="font-size:12px;margin:8px 0 4px">API-ключ</div>
                <div class="copy-row">
                    <input class="form-control mono" readonly value="@s.ApiKey" id="key" />
                    <button type="button" class="btn btn-sm btn-primary" onclick="ypCopy('key', this)">Копировать</button>
                </div>
                @if (canEdit)
                {
                    <form method="post" asp-page-handler="RegenKey" asp-route-id="@s.Id" class="mt-2"
                          onsubmit="return confirm('Перевыпустить ключ?')">
                        <button class="btn btn-sm btn-y-danger">Перевыпустить ключ</button>
                    </form>
                }
            </div>
            </div>
        </details>

        @if (canEdit)
        {
            <details class="card-y acc">
                <summary>🔕 Тихий режим</summary>
                <div class="acc-body">
                    <div class="muted mb-2" style="font-size:12px">
                        Заглушка отключает <strong>отправку</strong> тревог по серверу. Проблемы остаются видны на этой
                        странице и в отчёте — просто без уведомлений в Telegram/почту.
                    </div>

                    <div class="mb-1"><strong style="font-size:13px">Заглушить сейчас</strong>
                        @if (s.AlertSnoozeUntil is { } until && until > DateTimeOffset.UtcNow)
                        {
                            <span class="muted" style="font-size:12px"> — активно до @UiHelpers.Omsk(until, "dd.MM HH:mm")</span>
                        }
                    </div>
                    <form method="post" asp-page-handler="Snooze" asp-route-id="@s.Id" class="mb-1">
                        <input class="form-control mb-2" name="reason" placeholder="Причина (необязательно): плановые работы, знаю про диск…" value="@s.AlertSnoozeReason" />
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <button class="btn btn-sm btn-primary" type="submit" name="hours" value="1">1 час</button>
                            <button class="btn btn-sm btn-primary" type="submit" name="hours" value="4">4 часа</button>
                            <button class="btn btn-sm btn-primary" type="submit" name="hours" value="24">Сутки</button>
                            <button class="btn btn-sm btn-primary" type="submit" name="hours" value="72">3 дня</button>
                            <button class="btn btn-sm btn-primary" type="submit" name="hours" value="168">Неделя</button>
                            <button class="btn btn-sm btn-y-danger" type="submit" name="hours" value="0">Снять</button>
                        </div>
                    </form>

                    <hr style="border-color:var(--border)" />
                    <div class="mb-1"><strong style="font-size:13px">Окна обслуживания</strong>
                        <div class="muted" style="font-size:12px">
                            Повторяющиеся интервалы (по Омску), когда не тревожим по <em>офлайну и ping</em> — под плановые
                            перезагрузки/обновления. Нехватку места и здоровье диска окна не глушат.
                        </div></div>
                    @{ var wins = AlertSuppression.ParseWindows(s.MaintenanceWindowsJson); }
                    <form method="post" asp-page-handler="SaveWindows" asp-route-id="@s.Id">
                        <div id="mw-list">
                            @for (var wi = 0; wi < wins.Count; wi++)
                            {
                                var w = wins[wi];
                                <div class="mw-row" style="border:1px solid var(--border);border-radius:8px;padding:8px;margin-bottom:8px">
                                    <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px">
                                        @{ var dayNames = new[] { "Вс", "Пн", "Вт", "Ср", "Чт", "Пт", "Сб" }; }
                                        @for (var d = 0; d < 7; d++)
                                        {
                                            var on = w.Days.Contains(d);
                                            <label class="mw-day" style="font-size:12px;padding:3px 8px;border:1px solid var(--border);border-radius:6px;cursor:pointer;@(on ? "background:var(--card-2);border-color:var(--accent)" : "")">
                                                <input type="checkbox" class="mw-day-cb" value="@d" @(on ? "checked" : "") style="margin-right:3px" />@dayNames[d]
                                            </label>
                                        }
                                    </div>
                                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                        <span class="muted" style="font-size:12px">с</span>
                                        <input class="form-control mw-start" style="max-width:110px" type="time" value="@($"{w.StartMin / 60:00}:{w.StartMin % 60:00}")" />
                                        <span class="muted" style="font-size:12px">до</span>
                                        <input class="form-control mw-end" style="max-width:110px" type="time" value="@($"{w.EndMin / 60:00}:{w.EndMin % 60:00}")" />
                                        <button type="button" class="btn btn-sm btn-y-danger mw-del">Удалить</button>
                                    </div>
                                    <input type="hidden" name="mw_days" class="mw-days" value="@string.Join(",", w.Days)" />
                                    <input type="hidden" name="mw_start" class="mw-start-h" value="@($"{w.StartMin / 60:00}:{w.StartMin % 60:00}")" />
                                    <input type="hidden" name="mw_end" class="mw-end-h" value="@($"{w.EndMin / 60:00}:{w.EndMin % 60:00}")" />
                                </div>
                            }
                        </div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <button type="button" class="btn btn-sm btn-primary" id="mw-add">+ Добавить окно</button>
                            <button class="btn btn-sm btn-primary" type="submit">Сохранить окна</button>
                        </div>
                    </form>
                </div>
            </details>

            <details class="card-y acc">
                <summary>📡 Мониторинг и оповещения</summary>
                <div class="acc-body">
                <div class="muted mb-2" style="font-size:12px">
                    Уведомления приходят в Telegram-тему клиента при падении и при восстановлении.
                </div>
                <form method="post" asp-page-handler="SaveMonitoring" asp-route-id="@s.Id">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="monitorOffline" value="true" id="mo" @(s.MonitorOfflineAlert ? "checked" : "") />
                        <label class="form-check-label" for="mo">Следить за связью с агентом
                            <div class="muted" style="font-size:12px">Агент молчит дольше порога «офлайн» → «пропала связь с сервером»</div></label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="monitorPing" value="true" id="mp" @(s.MonitorPing ? "checked" : "") />
                        <label class="form-check-label" for="mp">Пинговать внешний IP (@(string.IsNullOrWhiteSpace(s.ExternalIpAddress) ? "не задан!" : s.ExternalIpAddress))
                            <div class="muted" style="font-size:12px">Внешний IP не отвечает на ping → «на адресе пропал интернет»</div></label>
                    </div>
                    @{ var pi = Math.Max(10, s.PingIntervalSeconds); }
                    <div class="mb-2" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                        <span class="muted" style="font-size:12px;flex:0 0 110px">Проверять каждые</span>
                        <input class="form-control" style="max-width:70px" type="number" min="0" max="168" name="pingH" value="@(pi / 3600)" /><span class="muted" style="font-size:12px">ч</span>
                        <input class="form-control" style="max-width:70px" type="number" min="0" max="59" name="pingM" value="@(pi % 3600 / 60)" /><span class="muted" style="font-size:12px">мин</span>
                        <input class="form-control" style="max-width:70px" type="number" min="0" max="59" name="pingS" value="@(pi % 60)" /><span class="muted" style="font-size:12px">сек</span>
                    </div>

                    <div class="mb-2" style="margin-top:10px"><strong style="font-size:13px">Пороги по дискам</strong>
                        <div class="muted" style="font-size:12px">Свободного места меньше N% → уведомление. По умолчанию @Model.DiskDefaultPercent%. 0 = выключить для диска.</div></div>
                    @if (!Model.Disks.Any())
                    {
                        <div class="muted mb-2" style="font-size:12px">Диски появятся после первого отчёта агента 2.2+.</div>
                    }
                    else
                    {
                        foreach (var d in Model.Disks)
                        {
                            var th = Model.DiskThresholds.TryGetValue(d.Name, out var v) ? v : Model.DiskDefaultPercent;
                            <div class="mb-2" style="display:flex;align-items:center;gap:8px">
                                <span style="flex:0 0 110px">@d.Name @(d.Label is null ? "" : $"({d.Label})")</span>
                                <input class="form-control" style="max-width:90px" type="number" min="0" max="99"
                                       name="th_@d.Name" value="@th" />
                                <span class="muted" style="font-size:12px">% свободно, мин.</span>
                            </div>
                        }
                    }
                    <div class="mb-2" style="margin-top:14px"><strong style="font-size:13px">Задания архивации по папкам</strong>
                        <div class="muted" style="font-size:12px">
                            <strong>Тип:</strong> для инкрементных/дифференциальных заданий сервер не тревожит об «усадке»
                            файла (там размеры заведомо разные). <strong>Порог устаревания:</strong> через сколько дней
                            без новых файлов папка проблемная; 0 = общий порог сервера
                            (@(s.BackupStaleDays > 0 ? s.BackupStaleDays + " дн." : $"по умолчанию {Model.DefaultBackupStaleDays} дн.")),
                            для еженедельного поставьте 8, для ежемесячного — 35.
                        </div></div>
                    @{ var monFolders = Model.Report?.Folders ?? new List<Ypmon.Shared.FolderStatusDto>(); }
                    @if (!monFolders.Any())
                    {
                        <div class="muted mb-2" style="font-size:12px">Папки появятся после первого полного отчёта агента.</div>
                    }
                    else
                    {
                        foreach (var f in monFolders)
                        {
                            var cur = Model.FolderStaleDays.TryGetValue(f.Name, out var fv) ? fv : 0;
                            var ftype = Model.FolderTypes.TryGetValue(f.Name, out var tv) ? tv : "Full";
                            <div class="mb-2" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                                <span style="flex:1 1 140px;overflow:hidden;text-overflow:ellipsis" title="@f.Path">@f.Name</span>
                                <select class="form-select" style="max-width:150px" name="ft_@f.Name">
                                    <option value="Full" selected="@(ftype == "Full")">Полный</option>
                                    <option value="Incremental" selected="@(ftype == "Incremental")">Инкрементный</option>
                                    <option value="Differential" selected="@(ftype == "Differential")">Дифференциальный</option>
                                </select>
                                <input class="form-control" style="max-width:80px" type="number" min="0" max="3650"
                                       name="fs_@f.Name" value="@cur" title="Порог устаревания, дней" />
                                <span class="muted" style="font-size:12px">дн.</span>
                            </div>
                        }
                    }
                    <button class="btn btn-primary w-100 mt-2" type="submit">Сохранить мониторинг</button>
                </form>
                </div>
            </details>

            <details class="card-y acc">
                <summary>✏️ Редактировать сервер</summary>
                <div class="acc-body">
                <form method="post" asp-page-handler="Save" asp-route-id="@s.Id">
                    <div class="mb-2"><label>Название</label><input class="form-control" asp-for="Name" /></div>
                    <div class="mb-2"><label>Физический адрес</label><input class="form-control" asp-for="PhysicalAddress" placeholder="напр. ЦОД, стойка 5" /></div>
                    <div class="mb-2"><label>Локальный IP</label><input class="form-control" asp-for="IpAddress" /></div>
                    <div class="mb-2"><label>Внешний IP (роутер) — для пинга</label><input class="form-control" asp-for="ExternalIpAddress" /></div>
                    <div class="mb-2"><label>Тревога, если нет новых файлов N дней (0 = по умолчанию @Model.DefaultBackupStaleDays)</label>
                        <input class="form-control" type="number" min="0" asp-for="BackupStaleDays" /></div>
                    <div class="mb-3"><label>Описание</label><textarea class="form-control" asp-for="Description" rows="2"></textarea></div>
                    <button class="btn btn-primary w-100" type="submit">Сохранить</button>
                </form>
                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="mt-2"
                      onsubmit="return confirm('Удалить сервер?')">
                    <button class="btn btn-y-danger w-100" type="submit">Удалить сервер</button>
                </form>
                </div>
            </details>
        }
    </div>
    }

@section Scripts {
    <script>
        function ypCopy(id, btn) {
            var el = document.getElementById(id);
            el.select(); el.setSelectionRange(0, 99999);
            var done = function () { var t = btn.textContent; btn.textContent = 'Скопировано'; setTimeout(function () { btn.textContent = t; }, 1500); };
            if (navigator.clipboard) { navigator.clipboard.writeText(el.value).then(done, function () { document.execCommand('copy'); done(); }); }
            else { document.execCommand('copy'); done(); }
        }

        // --- Окна обслуживания: добавление/удаление строк и синхронизация в скрытые поля перед отправкой ---
        (function () {
            var list = document.getElementById('mw-list');
            if (!list) return;
            var dayNames = ['Вс', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];

            function rowHtml() {
                var days = '';
                for (var d = 0; d < 7; d++) {
                    days += '<label class="mw-day" style="font-size:12px;padding:3px 8px;border:1px solid var(--border);border-radius:6px;cursor:pointer">' +
                            '<input type="checkbox" class="mw-day-cb" value="' + d + '" style="margin-right:3px" />' + dayNames[d] + '</label>';
                }
                return '<div class="mw-row" style="border:1px solid var(--border);border-radius:8px;padding:8px;margin-bottom:8px">' +
                       '<div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px">' + days + '</div>' +
                       '<div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">' +
                       '<span class="muted" style="font-size:12px">с</span>' +
                       '<input class="form-control mw-start" style="max-width:110px" type="time" value="02:00" />' +
                       '<span class="muted" style="font-size:12px">до</span>' +
                       '<input class="form-control mw-end" style="max-width:110px" type="time" value="04:00" />' +
                       '<button type="button" class="btn btn-sm btn-y-danger mw-del">Удалить</button></div>' +
                       '<input type="hidden" name="mw_days" class="mw-days" />' +
                       '<input type="hidden" name="mw_start" class="mw-start-h" />' +
                       '<input type="hidden" name="mw_end" class="mw-end-h" /></div>';
            }

            document.getElementById('mw-add').addEventListener('click', function () {
                list.insertAdjacentHTML('beforeend', rowHtml());
            });

            list.addEventListener('click', function (e) {
                if (e.target.classList.contains('mw-del')) e.target.closest('.mw-row').remove();
                // Подсветка выбранных дней.
                if (e.target.classList.contains('mw-day-cb')) {
                    var lbl = e.target.closest('.mw-day');
                    if (e.target.checked) { lbl.style.background = 'var(--card-2)'; lbl.style.borderColor = 'var(--accent)'; }
                    else { lbl.style.background = ''; lbl.style.borderColor = 'var(--border)'; }
                }
            });

            // Перед отправкой переносим состояние видимых контролов в скрытые поля, которые читает сервер.
            list.closest('form').addEventListener('submit', function () {
                Array.prototype.forEach.call(list.querySelectorAll('.mw-row'), function (row) {
                    var days = Array.prototype.slice.call(row.querySelectorAll('.mw-day-cb'))
                        .filter(function (c) { return c.checked; }).map(function (c) { return c.value; }).join(',');
                    row.querySelector('.mw-days').value = days;
                    row.querySelector('.mw-start-h').value = row.querySelector('.mw-start').value;
                    row.querySelector('.mw-end-h').value = row.querySelector('.mw-end').value;
                });
            });
        })();
    </script>
}
