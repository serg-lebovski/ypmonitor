@page
@model Ypmon.Server.Pages.Servers.IndexModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = "Серверы";
    var def = AvailabilityMonitor.DefaultDiskFreePercent;
}

<h1 class="page-title">Серверы</h1>
<div class="muted mb-3" style="font-size:13px">Нажмите на сервер, чтобы открыть настройку мониторинга и параметры.</div>

@if (!Model.Clients.Any(c => c.Servers.Any()))
{
    <div class="card-y muted">Серверов пока нет. Добавьте их на странице <a href="/Clients">Клиенты</a>.</div>
}

@foreach (var client in Model.Clients.Where(c => c.Servers.Any()))
{
    <details class="card-y acc">
        <summary>🗂️ <strong>@client.Name</strong> <span class="muted" style="font-weight:400">— серверов: @client.Servers.Count</span></summary>
        <div class="acc-body">
        @foreach (var s in client.Servers)
        {
            var offline = s.IsOffline(Model.OfflineThreshold);
            var outcome = offline ? JobOutcome.Unknown : s.LastOutcome;
            var disks = Model.DisksByServer.TryGetValue(s.Id, out var dl) ? dl : new();
            var folders = Model.FoldersByServer.TryGetValue(s.Id, out var fl) ? fl : new();
            var thresholds = Model.ThresholdsByServer.TryGetValue(s.Id, out var th) ? th : new();
            <details class="card-y acc" style="background:var(--card-2)">
                <summary>
                    <span class="dot @UiHelpers.DotCss(outcome)"></span>
                    <span style="flex:1"><strong>@s.Name</strong> <span class="muted" style="font-weight:400">@(s.LastMachineName ?? "")</span></span>
                    @if (offline) { <span class="badge-status st-offline">Офлайн</span> }
                    else { <span class="badge-status @UiHelpers.OutcomeCss(s.LastOutcome)">@UiHelpers.OutcomeText(s.LastOutcome)</span> }
                    @if (s.BackupShrinkActive) { <span class="badge-status st-warn">⚠️ объём</span> }
                </summary>
                <div class="acc-body">
                    <div class="cells">
                        <div class="cell"><div class="cell-l">Локальный IP</div><div class="cell-v mono">@(s.IpAddress ?? "—")</div></div>
                        <div class="cell"><div class="cell-l">Внешний IP</div><div class="cell-v mono">@(s.ExternalIpAddress ?? "—")</div></div>
                        <div class="cell"><div class="cell-l">Версия агента</div><div class="cell-v">@(s.LastAgentVersion ?? "—")</div></div>
                        <div class="cell"><div class="cell-l">Посл. отчёт</div><div class="cell-v">@UiHelpers.Ago(s.LastSeenAt)</div></div>
                    </div>

                    <div class="cells mt-2">
                        @* Заполненность дисков *@
                        <div class="cell" style="flex:1 1 260px">
                            <div class="cell-l">💽 Диски</div>
                            @if (!disks.Any())
                            {
                                <div class="muted" style="font-size:12px">нет данных</div>
                            }
                            else
                            {
                                foreach (var d in disks)
                                {
                                    var used = 100 - d.FreePercent;
                                    var thv = thresholds.TryGetValue(d.Name, out var tt) ? tt : def;
                                    var alarm = thv > 0 && d.FreePercent < thv;
                                    <div style="display:flex;align-items:center;gap:8px;margin:3px 0">
                                        <span style="flex:0 0 46px" class="mono">@d.Name</span>
                                        <div style="flex:0 0 80px;height:8px;background:var(--card);border-radius:4px;overflow:hidden">
                                            <div style="width:@used.ToString("0", System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:@(alarm ? "var(--err)" : used > 85 ? "var(--warn)" : "var(--ok)")"></div>
                                        </div>
                                        <span style="font-size:12px">@used.ToString("0")% занято</span>
                                        <span class="muted" style="font-size:12px">своб. @UiHelpers.Bytes(d.FreeBytes)</span>
                                    </div>
                                }
                            }
                        </div>

                        @* Задания архивации: копии + последний объём *@
                        <div class="cell" style="flex:1 1 260px">
                            <details>
                                <summary class="cell-l" style="cursor:pointer">📁 Задания архивации (@folders.Count)</summary>
                                @if (!folders.Any())
                                {
                                    <div class="muted" style="font-size:12px">нет данных</div>
                                }
                                else
                                {
                                    <table class="tbl" style="margin-top:6px">
                                        <thead><tr><th>Папка</th><th>Копий</th><th>Общий объём</th><th>Посл. архив</th><th>Свежий</th></tr></thead>
                                        <tbody>
                                        @foreach (var f in folders)
                                        {
                                            <tr>
                                                <td><span class="dot @UiHelpers.DotCss(f.Outcome)"></span>@f.Name</td>
                                                <td>@f.FileCount</td>
                                                <td>@UiHelpers.Bytes(f.TotalSizeBytes)</td>
                                                <td>@(f.LastFileSizeBytes > 0 ? UiHelpers.Bytes(f.LastFileSizeBytes) : "—")<div class="muted" style="font-size:11px">@f.LastFileName</div></td>
                                                <td>@UiHelpers.DateTimeAbs(f.LastBackupAt)</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                }
                            </details>
                        </div>
                    </div>

                    <a class="btn btn-sm btn-primary mt-2" href="/Servers/Details?id=@s.Id">⚙️ Открыть настройку сервера</a>
                </div>
            </details>
        }
        </div>
    </details>
}
