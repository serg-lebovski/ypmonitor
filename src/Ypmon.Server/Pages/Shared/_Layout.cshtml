@{
    var user = User?.Identity?.IsAuthenticated == true ? User.Identity!.Name : null;
    var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    string Active(string page) => (ViewContext.RouteData.Values["page"]?.ToString() ?? "")
        .StartsWith(page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — YPMon</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (user is not null)
{
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="logo">🛡️</span>
                <span class="brand-name">YPMon</span>
            </div>
            <nav class="nav flex-column">
                <a class="nav-link @Active("/Index")" href="/">📊 Дашборд</a>
                <a class="nav-link @Active("/Servers")" href="/Servers">🖥️ Серверы</a>
                <a class="nav-link @Active("/Clients")" href="/Clients">🗂️ Клиенты</a>
                <a class="nav-link @Active("/Errors")" href="/Errors">⚠️ Ошибки</a>
                <a class="nav-link @Active("/Settings")" href="/Settings">⚙️ Настройки</a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-chip">
                    <span class="avatar">@(user.Length > 0 ? user[0].ToString().ToUpper() : "?")</span>
                    <span>
                        <div class="uname">@user</div>
                        <div class="urole">@Ypmon.Server.Services.UiHelpers.RoleName(role)</div>
                    </span>
                </div>
                <a class="logout" href="/Logout">Выйти</a>
            </div>
        </aside>
        <main class="content">
            @* Постоянная строка поиска сервера: доступна на любой странице. *@
            <div class="topbar">
                <div class="gsearch">
                    <input id="gsearch-input" type="text" autocomplete="off" spellcheck="false"
                           placeholder="🔍 Найти сервер — имя, клиент, машина или IP…" />
                    <div id="gsearch-drop" class="gsearch-drop" hidden></div>
                </div>
            </div>
            <div class="container-fluid py-3">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    @RenderBody()
}
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@if (user is not null)
{
    <script>
    // Быстрый поиск сервера в шапке: подсказки с индикатором состояния, клик/Enter — переход на сервер.
    (function () {
        var input = document.getElementById('gsearch-input');
        var drop = document.getElementById('gsearch-drop');
        if (!input || !drop) return;

        var timer = null, items = [], active = -1;

        function hide() { drop.hidden = true; active = -1; }

        function open(item) {
            location.href = item.type === 'client'
                ? '/Clients/Details?id=' + item.id
                : '/Servers/Details?id=' + item.id + '&info=true';
        }

        function render() {
            if (!items.length) {
                drop.innerHTML = '<div class="gs-empty">Ничего не найдено</div>';
                drop.hidden = false;
                return;
            }
            drop.innerHTML = items.map(function (s, i) {
                var sub = [s.client, s.machine, s.ip].filter(Boolean).join(' · ');
                return '<div class="gs-item' + (i === active ? ' gs-active' : '') + '" data-id="' + s.id + '" data-i="' + i + '">' +
                       '<span class="gs-dot gs-' + s.status + '"></span>' +
                       '<span class="gs-text"><span class="gs-name"></span><span class="gs-sub"></span></span>' +
                       '<span class="gs-badge gs-' + s.status + '"></span></div>';
            }).join('');
            // Текст вставляем через textContent — имена клиентов/серверов не должны трактоваться как разметка.
            Array.prototype.forEach.call(drop.querySelectorAll('.gs-item'), function (el, i) {
                var s = items[i];
                el.querySelector('.gs-name').textContent = s.name;
                el.querySelector('.gs-sub').textContent = [s.client, s.machine, s.ip].filter(Boolean).join(' · ');
                el.querySelector('.gs-badge').textContent = s.label;
                el.addEventListener('mousedown', function (e) { e.preventDefault(); open(s); });
            });
            drop.hidden = false;
        }

        function search() {
            var q = input.value.trim();
            if (!q) { hide(); return; }
            fetch('/search/servers?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : []; })
                .then(function (data) { items = data || []; active = -1; render(); })
                .catch(function () { hide(); });
        }

        input.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(search, 200);   // не дёргаем сервер на каждую букву
        });

        input.addEventListener('keydown', function (e) {
            if (drop.hidden || !items.length) return;
            if (e.key === 'ArrowDown') { active = Math.min(active + 1, items.length - 1); render(); e.preventDefault(); }
            else if (e.key === 'ArrowUp') { active = Math.max(active - 1, 0); render(); e.preventDefault(); }
            else if (e.key === 'Enter') { open(items[active >= 0 ? active : 0]); e.preventDefault(); }
            else if (e.key === 'Escape') { hide(); }
        });

        input.addEventListener('focus', function () { if (input.value.trim()) search(); });
        document.addEventListener('click', function (e) {
            if (!drop.contains(e.target) && e.target !== input) hide();
        });
    })();
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
