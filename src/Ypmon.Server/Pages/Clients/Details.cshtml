@page
@model Ypmon.Server.Pages.Clients.DetailsModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = Model.Client?.Name ?? "Клиент";
    var canEdit = User.CanEdit();
    var baseUrl = $"{Request.Scheme}://{Request.Host.Host}:{Ypmon.Server.Services.ServerPorts.ReportsPort}";
}

<h1 class="page-title">🗂️ @Model.Client?.Name</h1>
<div class="muted mb-3">@Model.Client?.Description &nbsp; <a href="/Clients">← к списку клиентов</a></div>

@if (Model.Message is not null)
{
    <div class="alert-y alert-ok">@Model.Message</div>
}

<div class="dash-grid">
    <div>
        <details class="card-y acc" open>
            <summary>🖥️ Серверы клиента (@(Model.Client?.Servers.Count ?? 0))</summary>
            <div class="acc-body">
            @if (Model.Client is null || !Model.Client.Servers.Any())
            {
                <div class="muted">У клиента ещё нет серверов. Добавьте сервер и подключите к нему агента.</div>
            }
            else
            {
                foreach (var s in Model.Client.Servers)
                {
                    var offline = s.IsOffline(Model.OfflineThreshold);
                    <details class="card-y acc" style="background:var(--card-2)">
                        <summary>
                            <span class="dot @UiHelpers.DotCss(offline ? JobOutcome.Unknown : s.LastOutcome)"></span>
                            <span style="flex:1">@s.Name</span>
                            @if (offline)
                            {
                                <span class="badge-status st-offline">Офлайн</span>
                            }
                            else
                            {
                                <span class="badge-status @UiHelpers.OutcomeCss(s.LastOutcome)">@UiHelpers.OutcomeText(s.LastOutcome)</span>
                            }
                        </summary>
                        <div class="acc-body">
                            <div class="muted" style="font-size:13px">@(s.PhysicalAddress ?? "—") · IP: @(s.IpAddress ?? "—")</div>
                            @if (!string.IsNullOrWhiteSpace(s.Description))
                            {
                                <div class="muted" style="font-size:13px">@s.Description</div>
                            }
                            <div class="kv"><span class="k">Последний отчёт</span><span class="v">@UiHelpers.Ago(s.LastSeenAt)</span></div>
                            <div class="kv"><span class="k">Файлов в бэкапах</span><span class="v">@s.LastBackupCount</span></div>

                            <div class="conn-box mt-2">
                                <div class="muted" style="font-size:12px;margin-bottom:4px">Адрес сервера (для агента)</div>
                                <div class="copy-row">
                                    <input class="form-control mono" readonly value="@baseUrl" id="url_@s.Id" />
                                    <button type="button" class="btn btn-sm btn-primary" onclick="ypCopy('url_@s.Id', this)">Копировать</button>
                                </div>
                                <div class="muted" style="font-size:12px;margin:8px 0 4px">API-ключ</div>
                                <div class="copy-row">
                                    <input class="form-control mono" readonly value="@s.ApiKey" id="key_@s.Id" />
                                    <button type="button" class="btn btn-sm btn-primary" onclick="ypCopy('key_@s.Id', this)">Копировать</button>
                                </div>
                                <div class="mt-2" style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                                    @if (Model.AgentInstallerExists)
                                    {
                                        <a class="btn btn-sm btn-primary" href="/agent-installer" download>⬇️ Скачать агента@(Model.AgentInstallerVersion is null ? "" : $" ({Model.AgentInstallerVersion})")</a>
                                    }
                                    else
                                    {
                                        <span class="muted" style="font-size:12px">Установщик агента не загружен на сервер.</span>
                                    }
                                    @if (canEdit)
                                    {
                                        <form method="post" asp-page-handler="RegenKey" asp-route-id="@Model.Id" asp-route-serverId="@s.Id"
                                              onsubmit="return confirm('Перевыпустить ключ? Старый агент перестанет отправлять данные.')">
                                            <button class="btn btn-sm btn-y-danger">Перевыпустить ключ</button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <div style="display:flex;gap:8px;margin-top:12px">
                                <a class="btn btn-sm btn-primary" href="/Servers/Details?id=@s.Id">Открыть сервер</a>
                                @if (canEdit)
                                {
                                    <form method="post" asp-page-handler="DeleteServer" asp-route-id="@Model.Id" asp-route-serverId="@s.Id"
                                          onsubmit="return confirm('Удалить сервер?')">
                                        <button class="btn btn-sm btn-y-danger" type="submit">Удалить</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </details>
                }
            }
            </div>
        </details>
    </div>

    @if (canEdit)
    {
        <div class="panel">
            <details class="card-y acc" open>
                <summary>✏️ Изменить клиента</summary>
                <div class="acc-body">
                    <form method="post" asp-page-handler="SaveClient" asp-route-id="@Model.Id">
                        <div class="mb-2"><label>Название</label>
                            <input class="form-control" name="ClientName" value="@Model.Client?.Name" required /></div>
                        <div class="mb-3"><label>Описание</label>
                            <textarea class="form-control" name="ClientDescription" rows="2">@Model.Client?.Description</textarea></div>
                        <button class="btn btn-primary w-100" type="submit">Сохранить клиента</button>
                    </form>
                </div>
            </details>

            <details class="card-y acc">
                <summary>➕ Подключить сервер</summary>
                <div class="acc-body">
                    <div class="muted mb-3" style="font-size:13px">
                        При добавлении сервера сгенерируется API-ключ. Скачайте агента, установите на сервер клиента
                        и укажите в нём этот API-ключ и адрес сервера.
                    </div>
                    @if (Model.AgentInstallerExists)
                    {
                        <a class="btn btn-primary w-100 mb-3" href="/agent-installer" download>⬇️ Скачать установщик агента@(Model.AgentInstallerVersion is null ? "" : $" ({Model.AgentInstallerVersion})")</a>
                    }
                    else
                    {
                        <div class="alert-y alert-err mb-3" style="font-size:12px">Установщик агента не загружен на сервер.</div>
                    }
                    <form method="post" asp-page-handler="AddServer" asp-route-id="@Model.Id">
                        <div class="mb-3"><label>Название сервера</label>
                            <input class="form-control" asp-for="ServerName" required /></div>
                        <div class="mb-3"><label>Физический адрес</label>
                            <input class="form-control" asp-for="PhysicalAddress" placeholder="напр. ЦОД, стойка 5" /></div>
                        <div class="mb-3"><label>Сетевой адрес / IP</label>
                            <input class="form-control" asp-for="IpAddress" placeholder="напр. 10.0.0.12" /></div>
                        <div class="mb-3"><label>Описание</label>
                            <textarea class="form-control" asp-for="ServerDescription" rows="2"></textarea></div>
                        <button class="btn btn-primary w-100" type="submit">Добавить сервер</button>
                    </form>
                </div>
            </details>
        </div>
    }
</div>

@section Scripts {
    <script>
        function ypCopy(id, btn) {
            var el = document.getElementById(id);
            el.select(); el.setSelectionRange(0, 99999);
            var done = function () { var t = btn.textContent; btn.textContent = 'Скопировано'; setTimeout(function () { btn.textContent = t; }, 1500); };
            if (navigator.clipboard) { navigator.clipboard.writeText(el.value).then(done, function () { document.execCommand('copy'); done(); }); }
            else { document.execCommand('copy'); done(); }
        }
    </script>
}
