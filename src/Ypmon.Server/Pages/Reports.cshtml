@page
@model ReportsModel
@using Ypmon.Server.Services
@{
    ViewData["Title"] = "Отчёты";
    var canEdit = User.CanEdit();
}

<h1 class="page-title">📄 Отчёты</h1>

@if (canEdit)
{
    <div class="card-y mb-3">
        <h3>PDF-отчёт по клиенту</h3>
        <div class="muted mb-2" style="font-size:12px">
            По всем серверам клиента за период: состояние архивации, место на дисках,
            наработка накопителей и перезагрузки. Наработка накопителей и история перезагрузок
            приходят от агента 2.8 и выше — на серверах со старым агентом эти разделы будут пустыми.
        </div>
        @if (!Model.Clients.Any())
        {
            <div class="muted">Клиентов пока нет.</div>
        }
        else
        {
            <form method="post" asp-page-handler="Pdf" class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label class="muted" style="font-size:12px">Клиент</label>
                    <select class="form-select" name="clientId" required>
                        @foreach (var c in Model.Clients)
                        {
                            <option value="@c.Id">@c.Name (серверов: @c.Servers.Count)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="muted" style="font-size:12px">Период</label>
                    <select class="form-select" name="period">
                        <option value="30d">За последние 30 дней</option>
                        <option value="this-month">За текущий месяц</option>
                        <option value="prev-month">За прошлый месяц</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" type="submit">Получить PDF</button>
                </div>
            </form>
        }
    </div>
}

<div class="card-y mb-3">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <h3 style="margin-bottom:0">📊 Статистика проблем</h3>
        <form method="get" class="d-flex align-items-center" style="gap:8px">
            <select class="form-select form-select-sm" name="statsPeriod" onchange="this.form.submit()" style="width:auto">
                <option value="this-month" selected="@(Model.StatsPeriod == "this-month" ? "selected" : null)">За текущий месяц</option>
                <option value="prev-month" selected="@(Model.StatsPeriod == "prev-month" ? "selected" : null)">За прошлый месяц</option>
                <option value="30d" selected="@(Model.StatsPeriod == "30d" ? "selected" : null)">За последние 30 дней</option>
            </select>
        </form>
    </div>
    <div class="muted mb-2" style="font-size:12px">
        Период: @Model.StatsFrom.ToString("dd.MM.yyyy") — @Model.StatsTo.ToString("dd.MM.yyyy") (время Омска). Учитываются проблемы
        архивации и нехватки места на диске из полных отчётов агента (раз в 6 ч; глубина истории — см. настройку хранения отчётов).
        Тревоги SMART/перегрева/офлайна сюда не входят — по ним нет накопленной истории повторов.
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-4"><div class="metric"><div class="v">@Model.TotalClients</div><div class="l">Клиентов</div></div></div>
        <div class="col-sm-4"><div class="metric"><div class="v">@Model.TotalServers</div><div class="l">Серверов всего</div></div></div>
        <div class="col-sm-4"><div class="metric"><div class="v">@Model.ServerProblems.Count</div><div class="l">Серверов с проблемами за период</div></div></div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <h4 style="font-size:14px">Серверы клиентов и проблемы за период</h4>
            @if (!Model.Clients.Any(c => c.Servers.Count > 0))
            {
                <div class="muted">Серверов пока нет.</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Клиент</th><th>Серверов</th><th>Проблемных отчётов</th><th>Какие проблемы</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.Clients.Where(c => c.Servers.Count > 0))
                    {
                        var clientProblems = Model.ServerProblems.Where(p => p.Client == c.Name).ToList();
                        <tr>
                            <td><a href="/Clients/Details?id=@c.Id">@c.Name</a></td>
                            <td>@c.Servers.Count</td>
                            <td>@clientProblems.Sum(p => p.ErrorReports + p.WarningReports)</td>
                            <td style="font-size:12px">
                                @if (!clientProblems.Any())
                                {
                                    <span class="muted">без проблем</span>
                                }
                                else
                                {
                                    @foreach (var p in clientProblems)
                                    {
                                        <div><strong>@p.Server</strong>: @(p.ErrorReports + p.WarningReports) отч.
                                            (@string.Join(", ", p.Categories.Select(x => $"{x.Category}: {x.Count}")))</div>
                                    }
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
        <div class="col-lg-5">
            <h4 style="font-size:14px">Чаще всего повторяются (все серверы)</h4>
            @if (!Model.TopProblems.Any())
            {
                <div class="muted">За период проблем не зафиксировано.</div>
            }
            else
            {
                <table class="tbl">
                    <thead><tr><th>Проблема</th><th>Сколько раз</th></tr></thead>
                    <tbody>
                    @foreach (var p in Model.TopProblems)
                    {
                        <tr><td>@p.Category</td><td>@p.Count</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<div class="card-y mb-3">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <h3 style="margin-bottom:0">Адреса клиентов</h3>
        @if (Model.Clients.Any(c => c.Servers.Count > 0))
        {
            <a class="btn btn-sm btn-primary" asp-page-handler="AddressesCsv">⬇️ Скачать CSV</a>
        }
    </div>
    <div class="muted mb-2" style="font-size:12px">Физический и IP-адрес каждого сервера по клиентам.</div>
    @if (!Model.Clients.Any(c => c.Servers.Count > 0))
    {
        <div class="muted">Серверов пока нет.</div>
    }
    else
    {
        <table class="tbl">
            <thead><tr><th>Клиент</th><th>Сервер</th><th>Физический адрес</th><th>Локальный IP</th><th>Внешний IP</th><th>Провайдер</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Clients)
            {
                @foreach (var s in c.Servers)
                {
                    <tr>
                        <td><a href="/Clients/Details?id=@c.Id">@c.Name</a></td>
                        <td><a href="/Servers/Details?id=@s.Id">@s.Name</a></td>
                        <td>@(s.PhysicalAddress ?? "—")</td>
                        <td class="mono">@(s.IpAddress ?? "—")</td>
                        <td class="mono">@(s.ExternalIpAddress ?? "—")</td>
                        <td>@(s.IspProvider ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    }
</div>
